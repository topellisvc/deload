# Copy this file to .env.local and fill in real values from your Supabase
# project (Settings -> API). .env.local is gitignored and never committed.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key (Settings -> API -> "service_role" secret, NOT the
# anon/publishable one) — used only server-side by
# src/lib/supabase/admin.ts, currently just for admin account deletion
# (src/app/api/admin/delete-user/route.ts). Never exposed to the browser;
# do not prefix this with NEXT_PUBLIC_. Leaving it blank means the /admin
# roster's Delete button will fail with a clear error instead of working.
SBSECRET=

# Error monitoring (src/instrumentation.ts, src/instrumentation-client.ts).
# Create a project at sentry.io, then paste its DSN into both of these
# (same value in each — one's read on the server, one in the browser).
# Leaving them blank is a safe no-op: Sentry.init() is never called and
# nothing is captured or sent anywhere.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Optional, only needed for source-map upload / release tracking at build
# time (next.config.mjs) — from Sentry's org settings -> Auth Tokens. Not
# required for error capture to work; skip it until you want readable
# stack traces for production errors.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Notification emails (src/app/api/notifications/email/route.ts) — a coach
# assigning a program or a client accepting a coaching invite. Create a
# project at resend.com, verify a sending domain (or use their
# onboarding@resend.dev for testing), then set both of these. Leaving them
# blank is a safe no-op: the in-app notification (bell icon) still works,
# emails are just skipped.
RESEND_API_KEY=
NOTIFICATIONS_FROM_EMAIL=

# "Describe a program" (src/app/api/programs/parse-text/route.ts) — a coach
# types/pastes a program in plain English and Claude converts it into
# weeks/days/exercises. Create a key at console.anthropic.com (Settings ->
# API Keys) and set it below. Leaving it blank is a safe no-op: the
# "Describe a program" dialog still opens, it just tells the coach the
# feature isn't configured instead of erroring. Costs a few cents per
# generation (roughly $0.01-0.03 with the default model) — negligible
# unless usage is very high, in which case switch ANTHROPIC_MODEL below to
# a cheaper one.
ANTHROPIC_API_KEY=
# Optional — defaults to claude-sonnet-5. Set to claude-haiku-4-5-20251001
# for a cheaper/faster (usually still accurate enough) alternative.
ANTHROPIC_MODEL=
